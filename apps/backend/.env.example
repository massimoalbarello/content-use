# Development (Vite proxy on port 5173)
PORT=3000
BASE_URL=http://localhost:5173
DATA_FOLDER=./data
# Optional: a private durable secret is generated in DATA_FOLDER when omitted.
# BETTER_AUTH_SECRET=
# Optional: FreeTranscriptAPI deployment key for account credits instead of shared anonymous limits.
# FREETRANSCRIPT_API_KEY=

# Shared sliding-hour ceiling; response headers can lower it automatically.
CAPTION_HOURLY_LIMIT=50
